{
  "rules": {
    "players": {
      ".read": true,
      "$id": {
        ".write": true,
        ".validate": "newData.hasChildren(['name', 'createdAt'])",
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 32" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "retired": { ".validate": "newData.isBoolean()" },
        "$other": { ".validate": false }
      }
    },
    "matches": {
      ".read": true,
      "$id": {
        ".write": "(!data.exists() && newData.exists()) || !newData.exists()",
        ".validate": "newData.hasChildren(['winner', 'loser', 'at']) && newData.child('winner').val() != newData.child('loser').val() && root.child('players').child(newData.child('winner').val()).exists() && root.child('players').child(newData.child('loser').val()).exists() && (newData.hasChildren(['winnerScore', 'loserScore']) || (!newData.hasChild('winnerScore') && !newData.hasChild('loserScore')))",
        "winner": { ".validate": "newData.isString()" },
        "loser": { ".validate": "newData.isString()" },
        "at": { ".validate": "newData.isNumber()" },
        "winnerScore": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99 && newData.val() > newData.parent().child('loserScore').val()" },
        "loserScore": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99" },
        "$other": { ".validate": false }
      }
    }
  }
}
