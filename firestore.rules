rules_version = '2';
// Anyone with the link can read the ladder, add players and log or delete matches.
// Writes are shape-checked so the data stays clean.
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 32
        && request.resource.data.createdAt is number;
    }
    match /matches/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['winner', 'loser', 'at'])
        && request.resource.data.winner is string
        && request.resource.data.loser is string
        && request.resource.data.winner != request.resource.data.loser
        && exists(/databases/$(database)/documents/players/$(request.resource.data.winner))
        && exists(/databases/$(database)/documents/players/$(request.resource.data.loser))
        && request.resource.data.at is number;
      allow delete: if true;
    }
  }
}
